#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Params
{
    uint count;
    float gamma_r;
    float gamma_g;
    float gamma_b;
    uint samples_per_line;
    uint frame_seed;
    float noise_level;
    float samples_per_pixel;
    float black_floor;
    float apl_bias;
};

struct Voltage
{
    float voltage[1];
};

struct Current
{
    float current[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

static inline __attribute__((always_inline))
uint mix32(thread uint& seed)
{
    seed ^= (seed >> 16u);
    seed *= 2146121005u;
    seed ^= (seed >> 15u);
    seed *= 2221713035u;
    seed ^= (seed >> 16u);
    return seed;
}

static inline __attribute__((always_inline))
float _noise(thread const uint& seed)
{
    uint param = seed;
    uint _42 = mix32(param);
    return (float(_42 & 65535u) / 65535.0) - 0.5;
}

kernel void main0(constant Params& _63 [[buffer(0)]], device Voltage& _80 [[buffer(1)]], device Current& _201 [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= _63.count)
    {
        return;
    }
    float3 v = float3(_80.voltage[i * 3u], _80.voltage[(i * 3u) + 1u], _80.voltage[(i * 3u) + 2u]);
    if (_63.noise_level > 0.0)
    {
        float sample_x = float(i % _63.samples_per_line) / fast::max(_63.samples_per_pixel * 0.5, 1.0);
        uint param = _63.frame_seed ^ 2654435769u;
        uint _129 = mix32(param);
        uint param_1 = _129 ^ (i / _63.samples_per_line);
        uint _136 = mix32(param_1);
        uint row = _136;
        uint x = uint(floor(sample_x));
        uint param_2 = x;
        uint _145 = mix32(param_2);
        uint param_3 = row ^ _145;
        uint param_4 = x + 1u;
        uint _153 = mix32(param_4);
        uint param_5 = row ^ _153;
        float n = mix(_noise(param_3), _noise(param_5), smoothstep(0.0, 1.0, fract(sample_x)));
        v = fast::max(v + float3(_63.noise_level * n), float3(0.0));
    }
    float3 drive = fast::max(fast::max(v, float3(fast::max(_63.black_floor, 0.0))) + float3(_63.apl_bias), float3(0.0));
    float3 light = powr(drive, float3(_63.gamma_r, _63.gamma_g, _63.gamma_b));
    _201.current[i * 3u] = light.x;
    _201.current[(i * 3u) + 1u] = light.y;
    _201.current[(i * 3u) + 2u] = light.z;
}
