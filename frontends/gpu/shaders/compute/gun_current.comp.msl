#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Params
{
    uint count;
    float gamma_r;
    float gamma_g;
    float gamma_b;
    uint samples_per_line;
    uint frame_seed;
    float noise_level;
    float samples_per_pixel;
    float black_floor;
    float apl_bias;
    int picture_x;
    int picture_row;
};

struct Voltage
{
    float voltage[1];
};

struct Current
{
    float current[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

static inline __attribute__((always_inline))
float _noise(thread uint& seed)
{
    seed ^= (seed >> 16u);
    seed *= 2146121005u;
    seed ^= (seed >> 15u);
    seed *= 2221713035u;
    seed ^= (seed >> 16u);
    return (float(seed & 65535u) / 65535.0) - 0.5;
}

kernel void main0(constant Params& _55 [[buffer(0)]], device Voltage& _71 [[buffer(1)]], device Current& _202 [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= _55.count)
    {
        return;
    }
    float3 v = float3(_71.voltage[i * 3u], _71.voltage[(i * 3u) + 1u], _71.voltage[(i * 3u) + 2u]);
    if (_55.noise_level > 0.0)
    {
        float sample_x = float(int(i % _55.samples_per_line) - _55.picture_x) / fast::max(_55.samples_per_pixel * 0.5, 1.0);
        uint seed = (uint(int(i / _55.samples_per_line) - _55.picture_row) * 7919u) + (_55.frame_seed * 6271u);
        uint x = uint(int(floor(sample_x)));
        uint param = seed + (x * 1999u);
        float _150 = _noise(param);
        uint param_1 = seed + ((x + 1u) * 1999u);
        float _157 = _noise(param_1);
        float n = mix(_150, _157, smoothstep(0.0, 1.0, fract(sample_x)));
        v = fast::max(v + float3(_55.noise_level * n), float3(0.0));
    }
    float3 drive = fast::max(fast::max(v, float3(fast::max(_55.black_floor, 0.0))) + float3(_55.apl_bias), float3(0.0));
    float3 light = powr(drive, float3(_55.gamma_r, _55.gamma_g, _55.gamma_b));
    _202.current[i * 3u] = light.x;
    _202.current[(i * 3u) + 1u] = light.y;
    _202.current[(i * 3u) + 2u] = light.z;
}
