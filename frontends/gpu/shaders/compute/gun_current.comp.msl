};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

static inline __attribute__((always_inline))
uint mix32(thread uint& seed)
{
    seed ^= (seed >> 16u);
    seed *= 2146121005u;
    seed ^= (seed >> 15u);
    seed *= 2221713035u;
    seed ^= (seed >> 16u);
    return seed;
}

static inline __attribute__((always_inline))
float _noise(thread const uint& seed)
{
    uint param = seed;
    uint _91 = mix32(param);
    return (float(_91 & 65535u) / 65535.0) - 0.5;
}

static inline __attribute__((always_inline))
float trace_gate(thread const float& x, thread const uint& row, thread const float4& trace)
{
    float r = float(row);
    bool _34 = r < trace.z;
    bool _43;
    if (!_34)
    {
        _43 = r >= trace.w;
    }
    else
    {
        _43 = _34;
    }
    if (_43)
    {
        return 0.0;
    }
    return fast::clamp(fast::min(x + 0.5, trace.y) - fast::max(x - 0.5, trace.x), 0.0, 1.0);
}

kernel void main0(constant Params& _111 [[buffer(0)]], device Voltage& _126 [[buffer(1)]], device Current& _272 [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= _111.count)
    {
        return;
    }
    float3 v = float3(_126.voltage[i * 3u], _126.voltage[(i * 3u) + 1u], _126.voltage[(i * 3u) + 2u]);
    if (_111.noise_level > 0.0)
    {
        float sample_x = float(int(i % _111.samples_per_line) - _111.picture_x) / fast::max(_111.samples_per_pixel * 0.5, 1.0);
        uint param = _111.frame_seed ^ 2654435769u;
        uint _175 = mix32(param);
        uint param_1 = _175 ^ uint(int(i / _111.samples_per_line) - _111.picture_row);
        uint _188 = mix32(param_1);
        uint row = _188;
        uint x = uint(int(floor(sample_x)));
        uint param_2 = x;
        uint _198 = mix32(param_2);
        uint param_3 = row ^ _198;
        uint param_4 = x + 1u;
        uint _206 = mix32(param_4);
        uint param_5 = row ^ _206;
        float n = mix(_noise(param_3), _noise(param_5), smoothstep(0.0, 1.0, fract(sample_x)));
        v = fast::max(v + float3(_111.noise_level * n), float3(0.0));
    }
    float3 drive = fast::max(fast::max(v, float3(fast::max(_111.black_floor, 0.0))) + float3(_111.apl_bias), float3(0.0));
    float param_6 = float(i % _111.samples_per_line);
    uint param_7 = i / _111.samples_per_line;
    float4 param_8 = _111.trace;
    float3 light = powr(drive, float3(_111.gamma_r, _111.gamma_g, _111.gamma_b)) * trace_gate(param_6, param_7, param_8);
    _272.current[i * 3u] = light.x;
    _272.current[(i * 3u) + 1u] = light.y;
    _272.current[(i * 3u) + 2u] = light.z;
}
