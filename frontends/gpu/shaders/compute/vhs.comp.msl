    float c = 0.0;
    float x = float(i - base) + jitter;
    for (int k_1 = 0; k_1 < int(_57.tap_count); k_1++)
    {
        float p = x + float(k_1 - (int(_57.tap_count) / 2));
        float4 h = _274.taps[k_1];
        uint param_4 = base;
