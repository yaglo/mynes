    uint param_10 = (i - 1u) ^ seed;
    float _326 = hash(param_10);
    uint param_11 = i ^ seed;
    float _333 = hash(param_11);
    uint param_12 = (i + 1u) ^ seed;
    float _341 = hash(param_12);
    float n = ((0.25 * _326) + (0.5 * _333)) + (0.25 * _341);
    _347.signal_out[i] = (y + c) + (_57._noise * n);
