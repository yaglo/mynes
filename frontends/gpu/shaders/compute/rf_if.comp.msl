};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

kernel void main0(const device CarrierIn& _49 [[buffer(1)]], constant Params& _57 [[buffer(0)]], const device Taps& _109 [[buffer(2)]], device VideoOut& _191 [[buffer(3)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]], uint3 gl_WorkGroupID [[threadgroup_position_in_grid]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])
{
    threadgroup float2 tile[352];
    uint i = gl_GlobalInvocationID.x;
    int first = int(gl_WorkGroupID.x * 256u) - 48;
    for (uint k = gl_LocalInvocationID.x; k < 352u; k += 256u)
    {
        tile[k] = _49.carrier[clamp(first + int(k), 0, int(_57.count) - 1)];
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (i >= _57.count)
    {
        return;
    }
    int x = int(i % _57.samples_per_line);
    int base = int(i) - x;
    int middle = int(_57.tap_count) / 2;
    float2 v = tile[int(i) - first] * ((device float*)&_109.taps[middle])[0u];
    for (int d = 1; d <= middle; d++)
    {
        float2 a = tile[(base + clamp(x + d, 0, int(_57.samples_per_line) - 1)) - first];
        float2 b = tile[(base + clamp(x - d, 0, int(_57.samples_per_line) - 1)) - first];
        float2 h = _109.taps[middle + d];
        float2 sum = a + b;
        float2 difference = a - b;
        v += ((sum * h.x) + (float2(-difference.y, difference.x) * h.y));
    }
    _191.video[i] = (0.78041827678680419921875 - length(v)) / 0.65541827678680419921875;
}
