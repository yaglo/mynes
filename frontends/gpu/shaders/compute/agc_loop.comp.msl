    {
        float depth = fast::max((porch_mean[line_1] - tip_mean[line_1]) + (_31.noise_peak * tip_sigma[line_1]), 0.0);
        if (depth > 9.9999997473787516355514526367188e-05)
        {
            float param = depth / _31.target_level;
            _247 = to_db(param);
