#pragma clang diagnostic ignored "-Wmissing-prototypes"
#pragma clang diagnostic ignored "-Wmissing-braces"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T, size_t Num>
struct spvUnsafeArray
{
    T elements[Num ? Num : 1];

    thread T& operator [] (size_t pos) thread
    {
        return elements[pos];
    }
    constexpr const thread T& operator [] (size_t pos) const thread
    {
        return elements[pos];
    }

    device T& operator [] (size_t pos) device
    {
        return elements[pos];
    }
    constexpr const device T& operator [] (size_t pos) const device
    {
        return elements[pos];
    }

    constexpr const constant T& operator [] (size_t pos) const constant
    {
        return elements[pos];
    }

    threadgroup T& operator [] (size_t pos) threadgroup
    {
        return elements[pos];
    }
    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
    {
        return elements[pos];
    }
};

struct Params
{
    uint signal_w;
    uint num_lines;
    uint radius;
    float growth;
    float4 weights[9];
    float4 wide_weights[9];
    float4 over_weights[9];
};

struct RGBIn
{
    float rgb_in[1];
};

struct RGBOut
{
    float rgb_out[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

static inline __attribute__((always_inline))
float3 read_rgb(thread const uint& base, thread const int& x, constant Params& _34, device RGBIn& _49)
{
    uint i = (base + uint(clamp(x, 0, int(_34.signal_w) - 1))) * 3u;
    return float3(_49.rgb_in[i], _49.rgb_in[i + 1u], _49.rgb_in[i + 2u]);
}

static inline __attribute__((always_inline))
float3 deposit(thread const float3& current, thread const uint& dx, constant Params& _34)
{
    float narrow = _34.weights[dx / 4u][dx % 4u];
    if (_34.growth <= 0.0)
    {
        return current * narrow;
    }
    float wide = _34.wide_weights[dx / 4u][dx % 4u];
    float over = _34.over_weights[dx / 4u][dx % 4u];
    float3 nominal = mix(float3(narrow), float3(wide), fast::clamp(current, float3(0.0), float3(1.0)));
    return current * mix(nominal, float3(over), fast::clamp((current - float3(1.0)) / float3(3.0), float3(0.0), float3(1.0)));
}

kernel void main0(constant Params& _34 [[buffer(0)]], device RGBIn& _49 [[buffer(1)]], device RGBOut& _262 [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]], uint3 gl_WorkGroupID [[threadgroup_position_in_grid]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])
{
    threadgroup spvUnsafeArray<float3, 320> tile;
    uint sx = gl_GlobalInvocationID.x;
    uint sy = gl_GlobalInvocationID.y;
    if (sy >= _34.num_lines)
    {
        return;
    }
    uint base = sy * _34.signal_w;
    int first = int(gl_WorkGroupID.x * 256u) - int(_34.radius);
    for (uint k = gl_LocalInvocationID.x; k < (256u + (2u * _34.radius)); k += 256u)
    {
        uint param = base;
        int param_1 = first + int(k);
        tile[k] = read_rgb(param, param_1, _34, _49);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sx >= _34.signal_w)
    {
        return;
    }
    uint local = gl_LocalInvocationID.x + _34.radius;
    float3 param_2 = tile[local];
    uint param_3 = 0u;
    float3 current = deposit(param_2, param_3, _34);
    for (uint dx = 1u; dx <= _34.radius; dx++)
    {
        float3 param_4 = tile[local - dx];
        uint param_5 = dx;
        float3 param_6 = tile[local + dx];
        uint param_7 = dx;
        current += (deposit(param_4, param_5, _34) + deposit(param_6, param_7, _34));
    }
    uint out_idx = (base + sx) * 3u;
    _262.rgb_out[out_idx] = current.x;
    _262.rgb_out[out_idx + 1u] = current.y;
    _262.rgb_out[out_idx + 2u] = current.z;
}
