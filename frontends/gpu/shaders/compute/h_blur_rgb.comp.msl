#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Params
{
    uint signal_w;
    uint num_lines;
    uint radius;
    float growth;
    float4 weights[9];
    float4 wide_weights[9];
    float4 over_weights[9];
};

struct RGBIn
{
    float rgb_in[1];
};

struct RGBOut
{
    float rgb_out[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

static inline __attribute__((always_inline))
float3 read_rgb(thread const uint& base, thread const int& x, constant Params& v_34, device RGBIn& v_49)
{
    uint i = (base + uint(clamp(x, 0, int(v_34.signal_w) - 1))) * 3u;
    return float3(v_49.rgb_in[i], v_49.rgb_in[i + 1u], v_49.rgb_in[i + 2u]);
}

static inline __attribute__((always_inline))
float3 deposit(thread const float3& current, thread const uint& dx, constant Params& v_34)
{
    float narrow = v_34.weights[dx / 4u][dx % 4u];
    if (v_34.growth <= 0.0)
    {
        return current * narrow;
    }
    float wide = v_34.wide_weights[dx / 4u][dx % 4u];
    float over = v_34.over_weights[dx / 4u][dx % 4u];
    float3 nominal = mix(float3(narrow), float3(wide), fast::clamp(current, float3(0.0), float3(1.0)));
    return current * mix(nominal, float3(over), fast::clamp((current - float3(1.0)) / float3(3.0), float3(0.0), float3(1.0)));
}

kernel void main0(constant Params& v_34 [[buffer(0)]], device RGBIn& v_49 [[buffer(1)]], device RGBOut& _262 [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]], uint3 gl_WorkGroupID [[threadgroup_position_in_grid]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])
{
    threadgroup float3 tile[320];
    uint sx = gl_GlobalInvocationID.x;
    uint sy = gl_GlobalInvocationID.y;
    if (sy >= v_34.num_lines)
    {
        return;
    }
    uint base = sy * v_34.signal_w;
    int first = int(gl_WorkGroupID.x * 256u) - int(v_34.radius);
    for (uint k = gl_LocalInvocationID.x; k < (256u + (2u * v_34.radius)); k += 256u)
    {
        uint param = base;
        int param_1 = first + int(k);
        tile[k] = read_rgb(param, param_1, v_34, v_49);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (sx >= v_34.signal_w)
    {
        return;
    }
    uint local = gl_LocalInvocationID.x + v_34.radius;
    float3 param_2 = tile[local];
    uint param_3 = 0u;
    float3 current = deposit(param_2, param_3, v_34);
    for (uint dx = 1u; dx <= v_34.radius; dx++)
    {
        float3 param_4 = tile[local - dx];
        uint param_5 = dx;
        float3 param_6 = tile[local + dx];
        uint param_7 = dx;
        current += (deposit(param_4, param_5, v_34) + deposit(param_6, param_7, v_34));
    }
    uint out_idx = (base + sx) * 3u;
    _262.rgb_out[out_idx] = current.x;
    _262.rgb_out[out_idx + 1u] = current.y;
    _262.rgb_out[out_idx + 2u] = current.z;
}
