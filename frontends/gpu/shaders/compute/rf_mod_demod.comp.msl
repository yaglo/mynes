kernel void main0(constant Params& _53 [[buffer(0)]], device CompositeInOut& _68 [[buffer(1)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint tid = gl_GlobalInvocationID.x;
