static inline __attribute__((always_inline))
float crossing(thread const uint& base, thread const int& from, thread const int& to, thread const float& level0, device Raster& _39)
{
    float s = 0.0;
    int _24 = from - 7;
    for (int k = _24; k < (from + 5); k++)
    {
        s += _39.raster[base + uint(k)];
    }
    float a = s / 12.0;
    for (int x = from; x < to; x++)
