#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Params
{
    uint total_count;
    uint samples_per_line;
    uint num_lines;
    float target_level;
    float attack_coeff;
    float release_coeff;
    float min_gain;
    float max_gain;
    float attack_slew_db;
    float noise_peak;
    float pad0;
    float pad1;
};

struct Gains
{
    float4 gains[1];
};

struct DataBuf
{
    float data[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

kernel void main0(constant Params& _20 [[buffer(0)]], device Gains& _52 [[buffer(2)]], device DataBuf& _80 [[buffer(1)]], uint3 gl_WorkGroupID [[threadgroup_position_in_grid]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])
{
    uint line = gl_WorkGroupID.x;
    if (line >= _20.num_lines)
    {
        return;
    }
    uint start = line * _20.samples_per_line;
    uint end = min((start + _20.samples_per_line), _20.total_count);
    float gain = ((device float*)&_52.gains[line])[0u];
    if (gain <= 0.0)
    {
        gain = 1.0;
    }
    uint _68 = start + gl_LocalInvocationID.x;
    for (uint i = _68; i < end; i += 256u)
    {
        _80.data[i] *= gain;
    }
}
