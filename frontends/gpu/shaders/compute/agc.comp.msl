kernel void main0(constant Params& _20 [[buffer(0)]], device DataBuf& _90 [[buffer(1)]], device CarryBuf& _169 [[buffer(2)]], uint3 gl_WorkGroupID [[threadgroup_position_in_grid]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])
{
    threadgroup float line_gain;
