kernel void main0(constant Params& _20 [[buffer(0)]], device DataBuf& _84 [[buffer(1)]], device CarryBuf& _163 [[buffer(2)]], uint3 gl_GlobalInvocationID [[thread_position_in_grid]])
{
    uint line = gl_GlobalInvocationID.x;
