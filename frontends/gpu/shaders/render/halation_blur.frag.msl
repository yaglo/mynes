#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct BlurParams
{
    float2 direction;
    int radius;
    float threshold;
    int do_threshold;
};

struct main0_out
{
    float4 frag_color [[color(0)]];
};

struct main0_in
{
    float2 uv [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant BlurParams& _13 [[buffer(0)]], texture2d<float> tex_input [[texture(0)]], sampler tex_inputSmplr [[sampler(0)]])
{
    main0_out out = {};
    float sigma = float(_13.radius) * 0.4000000059604644775390625;
    float inv_2sigma2 = 1.0 / ((2.0 * sigma) * sigma);
    float3 center = tex_input.sample(tex_inputSmplr, in.uv).xyz;
    if (_13.do_threshold == 1)
    {
        float luma = dot(center, float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
        float extract = fast::max(luma - _13.threshold, 0.0) / fast::max(1.0 - _13.threshold, 0.001000000047497451305389404296875);
        center *= extract;
    }
    float w0 = 1.0;
    float3 accum = center * w0;
    float weight_sum = w0;
    for (int i = 1; i <= _13.radius; i++)
    {
        float fi = float(i);
        float w = exp(((-fi) * fi) * inv_2sigma2);
        float2 offset = _13.direction * fi;
        float3 s_pos = tex_input.sample(tex_inputSmplr, (in.uv + offset)).xyz;
        float3 s_neg = tex_input.sample(tex_inputSmplr, (in.uv - offset)).xyz;
        if (_13.do_threshold == 1)
        {
            float luma_p = dot(s_pos, float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
            float luma_n = dot(s_neg, float3(0.2125999927520751953125, 0.715200006961822509765625, 0.072200000286102294921875));
            float ext_p = fast::max(luma_p - _13.threshold, 0.0) / fast::max(1.0 - _13.threshold, 0.001000000047497451305389404296875);
            float ext_n = fast::max(luma_n - _13.threshold, 0.0) / fast::max(1.0 - _13.threshold, 0.001000000047497451305389404296875);
            s_pos *= ext_p;
            s_neg *= ext_n;
        }
        accum += ((s_pos + s_neg) * w);
        weight_sum += (2.0 * w);
    }
    out.frag_color = float4(accum / float3(weight_sum), 1.0);
    return out;
}

