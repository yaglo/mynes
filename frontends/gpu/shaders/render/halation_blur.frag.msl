#pragma clang diagnostic ignored "-Wmissing-prototypes"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct BlurParams
{
    float2 direction;
    int radius;
    float threshold;
    int do_threshold;
    float input_gamma;
};

struct main0_out
{
    float4 frag_color [[color(0)]];
};

struct main0_in
{
    float2 uv [[user(locn0)]];
};

static inline __attribute__((always_inline))
float3 light(thread const float2& p, texture2d<float> tex_input, sampler tex_inputSmplr, constant BlurParams& _31)
{
    float3 v = fast::max(tex_input.sample(tex_inputSmplr, p).xyz, float3(0.0));
    float3 _38;
    if (_31.input_gamma > 0.0)
    {
        _38 = powr(v, float3(_31.input_gamma));
    }
    else
    {
        _38 = v;
    }
    return _38;
}

fragment main0_out main0(main0_in in [[stage_in]], constant BlurParams& _31 [[buffer(0)]], texture2d<float> tex_input [[texture(0)]], sampler tex_inputSmplr [[sampler(0)]])
{
    main0_out out = {};
    float sigma = float(_31.radius) * 0.4000000059604644775390625;
    float inv_2sigma2 = 1.0 / ((2.0 * sigma) * sigma);
    float2 param = in.uv;
    float3 center = light(param, tex_input, tex_inputSmplr, _31);
    float w0 = 1.0;
    float3 accum = center * w0;
    float weight_sum = w0;
    for (int i = 1; i <= _31.radius; i++)
    {
        float fi = float(i);
        float w = exp(((-fi) * fi) * inv_2sigma2);
        float2 offset = _31.direction * fi;
        float2 param_1 = in.uv + offset;
        float3 s_pos = light(param_1, tex_input, tex_inputSmplr, _31);
        float2 param_2 = in.uv - offset;
        float3 s_neg = light(param_2, tex_input, tex_inputSmplr, _31);
        accum += ((s_pos + s_neg) * w);
        weight_sum += (2.0 * w);
    }
    out.frag_color = float4(accum / float3(weight_sum), 1.0);
    return out;
}
